{
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "dotenvx run -- deno run --unstable-cron --watch --allow-net --allow-env --allow-read --allow-sys src/main.ts",
        "test": "dotenvx run -- deno test --allow-net --allow-env --allow-read --allow-sys src/",
        "benchmark": "dotenvx run -- deno run --allow-net --allow-env --allow-read --allow-sys --allow-write=benchmark benchmark/run_benchmark.ts",
        "benchmark:list": "dotenvx run -- deno run --allow-net --allow-env --allow-read --allow-sys benchmark/list_documents.ts",
        "benchmark:bge3": "dotenvx run -- deno run --allow-net --allow-env --allow-read --allow-sys --allow-write=benchmark benchmark/bge_m3_test.ts",
        "benchmark:bge3-fuse": "dotenvx run -- deno run --allow-net --allow-env --allow-read --allow-sys --allow-write=benchmark benchmark/fuse_bge3.ts",
        "benchmark:fts-rank": "dotenvx run -- deno run --allow-net --allow-env --allow-read --allow-sys --allow-write=benchmark benchmark/fts_rank_test.ts",
        "benchmark:migrate-bge3": "dotenvx run -- deno run --allow-net --allow-env --allow-read --allow-sys --allow-write=benchmark benchmark/migrate_bge3.ts"
    },
    "imports": {
        "@google/genai": "npm:@google/genai@^2.10.0",
        "@std/assert": "jsr:@std/assert@1",
        "drizzle-kit": "npm:drizzle-kit@^0.31.10",
        "drizzle-orm": "npm:drizzle-orm@^0.45.2",
        "hono": "npm:hono@^4",
        "@hono/zod-openapi": "npm:@hono/zod-openapi@^0.19",
        "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.5",
        "@supabase/supabase-js": "npm:@supabase/supabase-js@^2",
        "postgres": "npm:postgres@^3.4.9",
        "resend": "npm:resend@^6.14.0",
        "zod": "npm:zod@^3",
        "@upstash/redis": "npm:@upstash/redis@^1.34.0",
        "@upstash/ratelimit": "npm:@upstash/ratelimit@^1.2.1",
        "@upstash/vector": "npm:@upstash/vector@^1.2.0",
        "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3.600.0",
        "@aws-sdk/s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@^3.600.0",
        "@mistralai/mistralai": "npm:@mistralai/mistralai@^1.3.4",
        
    }
