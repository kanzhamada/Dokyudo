#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY=

# .env
# API
# PORT=8000
# HOSTNAME=
# Public URL of the backend (used as OAuth PKCE callback target).
# Set to the deployed URL in production, e.g. https://api.dokyudo.com
# API_URL=http://localhost:8000
NODE_ENV=

# Load-test bypass untuk rate limiter — hanya dihormati saat di-set eksplisit,
# misalnya saat menjalankan k6 ke environment yang menerapkan limit (default mati)
# LOAD_TEST_BYPASS_TOKEN=

# SUPABASE
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# DRIZZLE
DATABASE_URL=

# GOOGLE CAPTCHA
RECAPTCHA_SECRET_KEY=

# GOOGLE AI API
GOOGLE_API_KEY=

# UPSTASH
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RESEND
RESEND_API_KEY=

# MINIO
S3_ENDPOINT=
S3_PORT=
S3_USE_SSL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Free Provider Keys (for fallback rotation — system-owned)
GROQ_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
FREE_MISTRAL_API_KEY=
