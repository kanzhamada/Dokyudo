meta {
  name: Get Activity Logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/activities?page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  ~category: document
  ~startDate: 2026-07-01T00:00:00.000Z
  ~endDate: 2026-07-31T23:59:59.999Z
  ~search: harum
}

auth:bearer {
  token: {{accessToken}}
}
