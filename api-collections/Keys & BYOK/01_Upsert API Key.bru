meta {
  name: Upsert API Key
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/keys
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "provider": "gemini",
    "apiKey": {{llmApiKey}}
  }
}

vars:pre-request {
  llmApiKey: AQ.Ab8RN6KVoMjK2p6RQNAoSnaDH2jIHn-7VGB-p-5oxyBpwAL7dg
}

docs {
  Store or update a custom API Key (BYOK) for a specific provider.
  Supported providers: gemini, mistral, openrouter.
}
