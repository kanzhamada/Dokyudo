meta {
  name: Upsert API Key
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/keys
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "provider": "gemini",
    "apiKey": {{llmApiKey}}
  }
}

docs {
  Store or update a custom API Key (BYOK) for a specific provider.
  Supported providers: gemini, mistral, openrouter.
}
