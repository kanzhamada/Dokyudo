meta {
  name: Upsert API Key
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/keys
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "provider": "mistral",
    "apiKey": "hChW5npf5X30aNqUGW9zT65gtzaf7Fcn"
  }
}

docs {
  Store or update a custom API Key (BYOK) for a specific provider.
  Supported providers: gemini, mistral, openrouter.
}
