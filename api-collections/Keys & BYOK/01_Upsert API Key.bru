meta {
  name: Upsert API Key
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/keys
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "provider": "openrouter",
    "apiKey": "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"
  }
}

docs {
  Store or update a custom API Key (BYOK) for a specific provider.
  Supported providers: gemini, mistral, openrouter.
}
