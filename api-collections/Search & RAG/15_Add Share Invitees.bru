meta {
  name: Add Share Invitees
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/rag/shares/{{shareCode}}/invitees
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "emails": ["tamu@example.com", "rekan@example.com"],
    "notify": true
  }
}

docs {
  Adds email invitees to an existing share owned by the caller's tenant.
  Adding the FIRST invitee promotes a public share to PRIVATE (generates the
  access token). Duplicate emails (including existing invitees) are skipped.

  Response: { "added": ["tamu@example.com"], "accessToken": "..." }

  - emails: required, 1-100 addresses. Normalized (lowercase), deduped, and
    must NOT include your own email.
  - notify: send invite emails immediately (default false).
  - 404 when the share does not exist or has expired.
  - accessToken: the share's access token — use it for `?invite=` links.
}
