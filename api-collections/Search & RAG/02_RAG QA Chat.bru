meta {
  name: RAG QA Chat
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/rag/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
  Accept: text/event-stream
}

body:json {
  {
    "question": "dimana potensi ketidakpastian pajak",
    "provider": "gemini",
    "model": "gemini-3.5-flash",
    "useByok": true
  //   "conversation_id": "{{conversationId}}"
  }
}

docs {
  Streams answer tokens back using Server-Sent Events (SSE). Retrieves top chunks, maps document-level indices [Doc 1..M], and enforces Single-Pass In-Context Sentence Citations [Doc N: Hlm. X]. Emits event: title for new conversations (turn 1) with an LLM-summarized title (max 7 words). Emits event: references conditionally when relevant context documents match (including 1-based index, documentId, title, and pages array).
}
