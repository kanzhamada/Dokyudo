meta {
  name: RAG QA Chat
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/rag/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
  Accept: text/event-stream
}

body:json {
  {
    "question": "dimana potensi ketidakpastian pajak",
    "provider": "gemini",
    "model": "gemini-3.5-flash",
    "useByok": true
  //   "conversation_id": "{{conversationId}}"
  }
}

docs {
  Streams answer tokens back using Server-Sent Events (SSE). Retrieves top 5 chunks, builds context prompt, and calls AI Gateway. Emits event: title for new conversations (turn 1) with an LLM-summarized title (max 7 words).
}
