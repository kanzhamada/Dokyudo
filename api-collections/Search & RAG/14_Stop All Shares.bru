meta {
  name: Stop All Shares
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/api/rag/conversations/{{conversationId}}/shares
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Revokes EVERY share of a conversation (conversation-level stop sharing).
  Cascades to share_invitees and purges all related Redis caches.

  Response: { "data": { "success": true, "deleted": <count> } }
}
