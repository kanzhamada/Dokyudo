meta {
  name: List Conversations
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/rag/conversations?limit=20
  body: none
  auth: bearer
}

params:query {
  limit: 20
  //   Cursor pagination: `nextCursor` dari respons sebelumnya — JSON komposit
  //   { p: isPinned, u: updatedAt, i: id } (opaque, dilempar apa adanya).
  //   cursor: {{nextCursor}}
}

auth:bearer {
  token: {{accessToken}}
}
