meta {
  name: Hybrid Semantic Search
  type: http
  seq: 1
}

get {
  url: '''
    {{baseUrl}}/api/search?query= store management solution
     &limit=3
'''
  body: none
  auth: none
}

params:query {
  query: '''
     store management solution
     
  '''
  limit: 3
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Performs tenant-safe hybrid search using Upstash Vector + Postgres FTS, merged via RRF (Reciprocal Rank Fusion).
}
