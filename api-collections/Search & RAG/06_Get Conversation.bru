meta {
  name: Get Conversation
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/rag/conversations/{{conversationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Returns a single conversation with all turns.
  
  Each turn contains:
  - `question`: user prompt
  - `answer`: assistant answer with inline citations (e.g. `[Doc 1: 48]`)
  - `contextReferences`: filtered references actually cited in `answer`, shaped as:
    ```json
    [
      {
        "index": 1,
        "documentId": "...",
        "title": "annual_report_pt_harum_energy_tbk_2020.pdf",
        "pages": [48]
      }
    ]
    ```
  - `attachmentDocumentIds`: attached document ids scoping this turn's retrieval (persisted — survives reloads)
  - `attachmentDocuments`: attached documents with display titles, shaped as `[{ "documentId": "...", "title": "laporan.pdf" }]` — resolved from the documents table on read; deleted docs fall back to `"Document"`
  - `alternatives`: retry variants of this turn (1:N di `turn_alternatives`), hanya varian terminal non-kosong:
    ```json
    [
      {
        "id": "...",
        "answer": "...",
        "status": "complete",
        "modelUsed": "...",
        "latencyMs": 1234,
        "contextReferences": null,
        "createdAt": "..."
      }
    ]
    ```
  - `modelUsed`, `createdAt`, etc.
}
