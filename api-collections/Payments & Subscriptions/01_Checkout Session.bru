meta {
  name: Checkout Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payments/checkout
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  ~Authorization: Bearer {{stripeSecret}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "tierToUnlock": "INVESTOR"
  }
}

vars:pre-request {
  stripeSecret: sk_test_51To4fe9XAhQgRBc1oTAcxL1EJ153FFResSp3oh1cUmfuyqXyRzMAYCugAgLjqwnOKqMQwwpXmAesQtQw2YGZl8pG00qNKfNlx1
}

docs {
  Creates a new Checkout Session via Stripe API. Returns a checkoutUrl that you can open in your browser to complete the payment. Requires valid JWT (tenant session).
}
