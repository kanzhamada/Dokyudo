meta {
  name: Checkout Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payments/checkout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tierToUnlock": "SIMULATE"
  }
}

docs {
  Creates a new Checkout Session via Stripe API. Returns a checkoutUrl that you can open in your browser to complete the payment. Requires valid JWT (tenant session).
  tierToUnlock accepts:
  - SIMULATE: 24h sandbox evaluation (one-time). Restricted to once per 30 days per email address (persisted across account deletions via pseudonymized HMAC hash).
  - OIL_INVESTOR: One-time investment invoice.
  - PRO: Recurring subscription.
}
