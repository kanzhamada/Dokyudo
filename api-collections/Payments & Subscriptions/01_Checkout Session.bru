meta {
  name: Checkout Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payments/checkout
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  ~Authorization: Bearer {{stripeSecret}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "tierToUnlock": "SIMULATE"
  }
}

docs {
  Creates a new Checkout Session via Stripe API. Returns a checkoutUrl that you can open in your browser to complete the payment. Requires valid JWT (tenant session).
  tierToUnlock accepts: SIMULATE (24h sandbox evaluation, one-time payment), OIL_INVESTOR (one-time invoice), PRO (recurring subscription).
}
