meta {
  name: Get Realtime Usage
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/me/usage
  body: none
  auth: none
}

docs {
  Returns realtime tenant usage statistics including tier name (FREE/SIMULATE/OIL_INVESTOR/PRO), expiresAt from tenant_subscriptions.expires_at (null for FREE/permanent plans), document uploads count, semantic searches count, Q&A message count, and total storage used in bytes.
}
