meta {
  name: Update Password
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/me/update-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "newPassword": "NewSecurePassword123!"
  }
}

docs {
  Updates the password for an already authenticated user. The session cookie is sent automatically by the Cookie Jar — no Authorization header needed. Upon success, all existing sessions for the user are invalidated globally and the session cookies are cleared (force re-login).
}
