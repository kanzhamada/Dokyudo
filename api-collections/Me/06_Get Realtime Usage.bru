meta {
  name: Get Realtime Usage
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/me/usage
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns realtime tenant usage statistics including tier name, document uploads count, semantic searches count, Q&A message count, and total storage used in bytes.
}
