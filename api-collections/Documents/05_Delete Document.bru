meta {
  name: Delete Document
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/documents/{{documentId}}
  body: none
  auth: none
}

docs {
  Deletes a document from the database, removes its chunks from Upstash Vector, and deletes the associated file from S3 (MinIO). For non-PDF documents the worker-converted PDF ({tenant}/{docId}.pdf) is also deleted, so no orphaned files remain. Storage quota is refunded atomically.
}
