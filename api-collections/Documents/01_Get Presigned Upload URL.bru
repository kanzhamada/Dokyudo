meta {
  name: Get Presigned Upload URL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/documents/presigned-url
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "filename": "financial_report_2023.pdf",
    "mimeType": "application/pdf",
    "sizeBytes": 1048576
  }
}

docs {
  Generates a presigned PUT URL directly to the self-hosted MinIO STB storage, bypassing backend bandwidth for large uploads (max 25MB). Creates a pending document record.
}
