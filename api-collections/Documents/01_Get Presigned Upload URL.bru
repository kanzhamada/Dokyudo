meta {
  name: Get Presigned Upload URL
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/documents/presigned
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Generates a presigned PUT URL directly to the Supabase Storage S3 object storage, bypassing backend bandwidth for large uploads (max 25MB).
}
