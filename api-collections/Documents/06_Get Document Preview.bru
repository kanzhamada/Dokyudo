meta {
  name: Get Document Preview
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/documents/:id/preview
  body: none
  auth: none
}

params:path {
  id: {{documentId}}
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Generates a presigned GET URL (12 hours) that can be used directly in an iframe, PDF viewer, or downloaded.
}
