meta {
  name: Rename Document
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/documents/{{documentId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "Laporan Keuangan 2026.pdf"
  }
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Updates a document title. The title must include the file extension and the extension cannot change — it must match the document's stored file extension. Characters are restricted to a safe whitelist (letters, digits, spaces, and . , - _ ( ) & + @ # : ! ?) to prevent XSS/SQL-injection payloads.
}
