meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  ~x-dokyudo-puzzle: snOakP0UsaBIxN3sLIIYVJvUIIxHn1N1OC3Zh2KhqonoJOh7YTbx
}

body:json {
  {
    "email": "kgitudong@gmail.com",
    "password": "Secure@123",
    "recaptchaToken": "{{recaptchaToken}}"
  }
}

vars:pre-request {
  recaptchaToken: dummy
}

docs {
  Logs in a tenant via Supabase Auth after reCAPTCHA v3 validation, lockout check, and anti-bruteforce rate limiting (Per-IP + Per-Email Password Spraying + User-Agent Anomaly Detection). Returns short-lived access JWT and refresh token. Failed attempts are logged to public.login_attempts. After 5 failures (same email in 15 min), account locks for 15 minutes. On success, also clears the Redis `unverified_email:{email}` registration cache. Tokens are auto-captured as runtime variables.
}
