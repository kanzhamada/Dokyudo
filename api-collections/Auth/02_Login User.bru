meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "kaitoukid818@gmail.com",
    "password": "kaitoukid81@gmail.com",
    "recaptchaToken": "{{recaptchaToken}}"
  }
}

vars:pre-request {
  recaptchaToken: ff
}

docs {
  Logs in a tenant via Supabase Auth after reCAPTCHA v3 validation, lockout check, and anti-bruteforce rate limiting. Returns short-lived access JWT and refresh token. Failed attempts are logged to public.login_attempts. After 5 failures (same email+IP in 15 min), account locks for 15 minutes. Tokens are auto-captured as runtime variables.
}
