meta {
  name: Get Profile
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Returns the authenticated user details, associated tenant context, and current subscription status.
  
  Implements Lazy Evaluation: Automatically checks `expiresAt` of the current subscription. If it has expired, silently downgrades the tenant tier to `FREE` before returning the response.
}
