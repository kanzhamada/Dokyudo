meta {
  name: Reset Password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "user@example.com",
    "otp": "12345678",
    "newPassword": "NewSecurePassword123!"
  }
}

docs {
  Resets the user's password using the email address, 8-digit OTP (or token_hash) received via email, and new password. The OTP is verified against Supabase Auth, and the password is set via Supabase Admin API.
}
