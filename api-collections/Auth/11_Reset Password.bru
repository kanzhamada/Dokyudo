meta {
  name: Reset Password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "kgitudong@gmail.com",
    "otp": "73562758",
    "newPassword": "NewSecurePassword123!"
  }
}

docs {
  Resets the user's password using the 6-digit OTP received via email. The OTP is verified against Supabase, and the new password is set. Previous sessions are invalidated.
}
