meta {
  name: OAuth GitHub Initiate
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/auth/oauth/github
  body: none
  auth: none
}

docs {
  Initiates the GitHub OAuth App flow.
  Returns HTTP 302 redirecting to GitHub's authorization endpoint with:
    - client_id, redirect_uri, scope=read:user user:email
    - state (random UUID, stored in Redis as oauth:{state} with 5-min TTL for CSRF protection)
  NOTE: followRedirects is disabled intentionally — the redirect URL itself is the testable artifact.
  Internal classification: PUBLIC (no auth token required).
  
}
