meta {
  name: OAuth GitHub Initiate
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/auth/oauth/github
  body: none
  auth: none
}

docs {
  Initiates the GitHub OAuth App flow via Supabase's built-in Server-Side PKCE.
  Returns HTTP 302 redirecting to GitHub's authorization endpoint.
  Supabase handles state/PKCE verification internally — no manual Redis state management needed.
  GitHub OAuth client credentials are configured in the Supabase Dashboard, not in backend env vars.
  Internal classification: PUBLIC (no auth token required).
}
