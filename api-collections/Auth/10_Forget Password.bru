meta {
  name: Forget Password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/forget-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "kgitudong@gmail.com",
    "recaptchaToken": "{{recaptchaToken}}"
  }
}

vars:pre-request {
  recaptchaToken: dummy
}

docs {
  Requests a password reset link and OTP via email. Generates a recovery OTP and magic link via Supabase Admin API and sends it using Resend.
}
