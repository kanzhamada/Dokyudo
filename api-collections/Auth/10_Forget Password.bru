meta {
  name: Forget Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/forget-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "kgitudong@gmail.com",
    "recaptchaToken": "{{recaptchaToken}}"
  }
}

vars:pre-request {
  recaptchaToken: dummy
}

docs {
  Requests a password reset link and OTP via email. Verifies that the user exists and is active in public.users. If found, generates a recovery OTP and magic link via Supabase Admin API and sends it using Resend. If not found or unverified, silently returns HTTP 200 to prevent email enumeration.
}
