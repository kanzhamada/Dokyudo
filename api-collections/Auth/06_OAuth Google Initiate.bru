meta {
  name: OAuth Google Initiate
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/auth/oauth/google
  body: none
  auth: none
}

docs {
  Initiates the Google OAuth 2.0 (OpenID Connect) flow via Supabase's built-in Server-Side PKCE.
  Returns HTTP 302 redirecting to Google's authorization endpoint.
  Supabase handles state/PKCE verification internally — no manual Redis state management needed.
  Google/GitHub OAuth client credentials are configured in the Supabase Dashboard, not in backend env vars.
  Internal classification: PUBLIC (no auth token required).
}
