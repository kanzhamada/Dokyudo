meta {
  name: Update Tenant Name
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/auth/tenant/name
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Kacrut"
  }
}

docs {
  Updates the display name of the authenticated user's tenant workspace. The session cookie is sent automatically by the Cookie Jar — no Authorization header needed. Name must be between 2 and 255 characters.
}
