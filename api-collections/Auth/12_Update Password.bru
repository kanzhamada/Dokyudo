meta {
  name: Update Password
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/auth/update-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "newPassword": "NewSecurePassword123!"
  }
}

vars:pre-request {
  : 
}

docs {
  Updates the password for an already authenticated user. Requires a valid Bearer token. Upon success, all existing sessions for the user are invalidated globally to force re-authentication.
}
