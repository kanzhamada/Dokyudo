meta {
  name: Update Password
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/auth/update-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "newPassword": "NewSecurePassword123!"
  }
}

