meta {
  name: Register Tenant
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "kgitudong@gmail.com",
    "password": "Secure@123",
    "recaptchaToken": "{{recaptchaToken}}"
  }
}

vars:pre-request {
  recaptchaToken: dummy
}

docs {
  Registers a new tenant and user mapping (1:1 relation) via Supabase Auth Admin API. Validates Google reCAPTCHA v3 token first (score >= 0.5). Protected by Per-IP rate limiting (Max 20 attempts/15m, Max 5 successful signups/15m, limit drops to 3 if >3 distinct User-Agents are used). User must verify email before login. Uses Supabase Admin `generateLink` to decouple email delivery, dispatching the verification link via the Resend API. Database trigger auto-creates public.users + public.tenants upon verification.
}
