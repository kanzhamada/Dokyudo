meta {
  name: Get Quota Status
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/quota
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

docs {
  Queries current month quota usage (uploads, searches, Q&A, storage in MB) against the tenant tier limits (Free vs Pro).
}
