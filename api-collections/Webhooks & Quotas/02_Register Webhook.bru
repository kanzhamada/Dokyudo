meta {
  name: Register Webhook
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/webhooks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "url": "https://client-app.com/webhooks"
  }
}

docs {
  Registers or updates a webhook destination URL to receive asynchronous status updates via signed POST payloads.
}
