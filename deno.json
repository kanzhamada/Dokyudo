{
    "tasks": {
        "dev": "deno run -A npm:concurrently -c \"blue,green\" -n \"backend,frontend\" \"deno task dev:backend\" \"deno task dev:frontend\"",
        "test": "cd apps/backend && dotenvx run -- deno test --allow-net --allow-env --allow-read src/",
        "dev:backend": "cd apps/backend && deno task dev",
        "dev:frontend": "cd apps/frontend && env npm run dev"
    },
    "imports": {
        "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.4.0",
        "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.11.6",
        "@std/assert": "jsr:@std/assert@1",
        "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.108.2",
        "@upstash/ratelimit": "npm:@upstash/ratelimit@^2.0.8",
        "@upstash/redis": "npm:@upstash/redis@^1.38.0",
        "drizzle-orm": "npm:drizzle-orm@^0.45.2",
        "hono": "npm:hono@^4.12.27",
        "postgres": "npm:postgres@^3.4.9",
        "resend": "npm:resend@^6.16.0"
    }
}
